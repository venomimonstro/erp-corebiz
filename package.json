{
  "name": "corebiz-business-os",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "infra:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml down",
    "db:migrate": "pnpm --filter @corebiz/api db:migrate",
    "bootstrap:local": "pnpm infra:up && pnpm db:migrate",
    "backup:db": "bash scripts/backup-postgres.sh",
    "restore:db": "bash scripts/restore-postgres.sh",
    "release:check": "bash scripts/release-check.sh",
    "release:gate": "bash scripts/production-gate.sh",
    "stability:check": "node scripts/stability-source-preflight.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
