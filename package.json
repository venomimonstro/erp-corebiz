{
  "name": "corebiz-business-os",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "infra:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml down",
    "db:migrate": "pnpm --filter @corebiz/api db:migrate",
    "bootstrap:local": "pnpm infra:up && pnpm db:migrate",
    "backup:db": "bash scripts/backup-postgres.sh",
    "restore:db": "bash scripts/restore-postgres.sh",
    "release:check": "bash scripts/release-check.sh",
    "release:gate": "bash scripts/production-gate.sh",
    "stability:check": "node scripts/stability-source-preflight.mjs",
    "golden:journeys": "node scripts/golden-business-journeys.mjs",
    "simulate:100-users": "node scripts/simulate-100-users.mjs",
    "slo:probe": "node scripts/slo-availability.mjs probe",
    "slo:report": "node scripts/slo-availability.mjs report",
    "slo:test": "node --test scripts/slo-availability.test.mjs",
    "owner:industry:test": "node --test scripts/owner-industry-journeys.test.mjs",
    "owner:industry:api": "node scripts/owner-17-vertical-api-e2e.mjs",
    "owner:business:e2e": "node scripts/owner-business-setup-e2e.mjs",
    "test:roles": "node --test scripts/multirole-source-contract.test.mjs",
    "test:roles:e2e": "node scripts/multirole-api-e2e.mjs",
    "test:dance:owner": "node --test scripts/dance-owner-contract.test.mjs scripts/dance-shift-pattern.test.mjs",
    "test:dance:owner:e2e": "node scripts/dance-two-branch-owner-e2e.mjs",
    "test:dance:recovery": "node --test scripts/dance-negative-onboarding.test.mjs",
    "test:benchmark": "node --test scripts/competitor-benchmark-contract.test.mjs",
    "test:wms:benchmark": "node --test scripts/wms-moysklad-axelot-contract.test.mjs",
    "test:wms:variance": "node --test scripts/wms-variance-approval-contract.test.mjs",
    "test:service-integrity": "node --test scripts/service-data-integrity-contract.test.mjs",
    "test:dance:integrity": "node --test scripts/dance-doctor-integrity.test.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
