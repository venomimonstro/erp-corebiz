NODE_ENV=development

# API
API_PORT=4000
DATABASE_URL=postgresql://corebiz:corebiz@localhost:5432/corebiz
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
# Do not use a blanket trust proxy value such as true or 0.0.0.0/0.
# Set CIDRs only for proxies under your control when using Docker/Caddy.
COREBIZ_TRUSTED_PROXIES=loopback

# Web
# Internal API target for the same-origin Next.js proxy on custom domains.
# Configure to the private API service origin in production, not a user URL.
COREBIZ_API_PROXY_ORIGIN=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_HOST=localhost:3000

# Session/security (replace in real environments)
SESSION_SECRET=change-me-with-strong-secret

# Transactional password recovery email (Unisender Go).
# Configure a verified sender + DKIM/SPF/DMARC before paid onboarding.
# Do not commit real credentials. Password reset responds identically for
# existing/non-existing accounts; provider delivery must be checked separately.
COREBIZ_UNISENDER_GO_KEY=
COREBIZ_EMAIL_SENDER=

# Private S3-compatible object storage for support files and future media.
# Production requires HTTPS. API credentials never reach the browser: clients
# receive only short-lived SigV4 URLs for one random tenant-bound object key.
COREBIZ_STORAGE_ENDPOINT=
COREBIZ_STORAGE_BUCKET=
COREBIZ_STORAGE_REGION=us-east-1
COREBIZ_STORAGE_ACCESS_KEY=
COREBIZ_STORAGE_SECRET_KEY=

# Mandatory in production when accepting support attachments. The scanner
# receives {"url":"<short-lived private GET URL>"} and must return {"clean":true}.
COREBIZ_FILE_SCAN_URL=
COREBIZ_FILE_SCAN_TOKEN=
# Unisender Go webhook "auth" value. Generate a random 32+ byte secret and
# configure the same value in webhook/set. Never use the API key here.
COREBIZ_UNISENDER_WEBHOOK_AUTH=
# 32 random bytes encoded as base64. Used only to AES-256-GCM encrypt TOTP
# secrets at rest. Rotation requires a controlled re-encryption procedure.
COREBIZ_MFA_ENCRYPTION_KEY=
